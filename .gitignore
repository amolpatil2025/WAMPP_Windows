# --- Zip / redistributable runtime (download separately) ---
# Apache Lounge build (keep conf only)
#/Apache24/**
#!/Apache24/conf/
#!/Apache24/conf/**

# PHP Windows builds
/php*/
/php*/**

# PHP runtime temp / CodeIgniter sessions (e.g. php8.0.30/tmp/ci_session*)
/php*/tmp/
/php*/tmp/**
**/php*/tmp/ci_session*

# Local mail catcher binary + DB (keep start scripts at repo root)
/mailpit/**
!/mailpit/.gitkeep
!/mailpit/mailpit.exe
# Apache Lounge / package junk
/-- Win32 VS18  --
/ReadMe.txt
/Security.txt
/New Text Document.txt
*.zip

# Runtime logs & pid
**/logs/
*.log
*.pid
Apache24/logs/

# Machine-specific install path for Apache Define WEBROOT
Apache24/conf/install-root.conf

# --- htdocs: keep panel, phpmyadmin, mail-test, root index only ---
/htdocs/**
!/htdocs/index.php
!/htdocs/panel/
!/htdocs/panel/**
!/htdocs/phpmyadmin/
!/htdocs/phpmyadmin/**
!/htdocs/mail-test/
!/htdocs/mail-test/**

# Local panel runtime (optional; uncomment to skip machine-specific data)
# /htdocs/panel/data/settings.json
# /htdocs/panel/data/sites.json
# /htdocs/panel/data/hosts.block.txt
/htdocs/panel/data/*.bak*
/htdocs/panel/data/_run_hidden.vbs

# --- Keep (not ignored): start.bat, scripts/, tray/, .gitignore ---

# phpMyAdmin runtime cache (must come after !/htdocs/phpmyadmin/**)
/htdocs/phpmyadmin/tmp/
/htdocs/phpmyadmin/tmp/**
