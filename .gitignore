# --- Zip / redistributable runtime (download separately) ---
# Apache Lounge build (keep conf only)
#/Apache24/**
#!/Apache24/conf/
#!/Apache24/conf/**

# PHP Windows builds (including versions downloaded from the panel)
/php*/
/php*/**

# PHP runtime temp / CodeIgniter sessions (e.g. php8.0.30/tmp/ci_session*)
/php*/tmp/
/php*/tmp/**
**/php*/tmp/ci_session*

# FTP accounts (password hashes) and runtime
/ftp/ftp.json
/ftp/*.tmp

# PHP download temp
/.php-download-tmp/

# Local mail catcher binary + DB (keep start scripts at repo root)
/mailpit/**
!/mailpit/.gitkeep
!/mailpit/mailpit.exe
# Apache Lounge / package junk
/-- Win32 VS18  --
/ReadMe.txt
/Security.txt
/New Text Document.txt
*.zip

# Runtime logs & pid
**/logs/
*.log
*.pid
Apache24/logs/

# Machine-specific install path for Apache Define WEBROOT
Apache24/conf/install-root.conf

# Auto-generated from php* folders (panel / download) — not for git
Apache24/conf/extra/httpd-php-versions.conf

# --- htdocs: keep panel, phpmyadmin, mail-test, root index only ---
/htdocs/**
!/htdocs/index.php
!/htdocs/panel/
!/htdocs/panel/**
!/htdocs/phpmyadmin/
!/htdocs/phpmyadmin/**
!/htdocs/mail-test/
!/htdocs/mail-test/**

# Local panel runtime
# /htdocs/panel/data/settings.json
# /htdocs/panel/data/sites.json
/htdocs/panel/data/*.bak*
/htdocs/panel/data/_run_hidden.vbs
/htdocs/panel/data/hosts.block.txt

# Dynamic PHP install / download state (must come after !/htdocs/panel/**)
/htdocs/panel/data/php-runtime.json
/htdocs/panel/data/php-download.json

# --- Keep (not ignored): start.bat, scripts/, tray/, .gitignore ---
# Keep Apache24/conf/extra/httpd-php-fpm.conf (shared localhost template)

# phpMyAdmin runtime cache (must come after !/htdocs/phpmyadmin/**)
/htdocs/phpmyadmin/tmp/
/htdocs/phpmyadmin/tmp/**
